# Copy this file to `.env` in this project (do not commit secrets).
# Restart `npm run dev` after changing env files. Vite only reads VITE_* into the client.

# Optional on Devnet. Empty uses the public Solana Devnet RPC fallback.
VITE_HELIUS_DEVNET_RPC=

# Server-only. Required for Mainnet. Loaded by Vite into process.env on `npm run dev`.
# Never put this value in VITE_* or client source. The browser uses same-origin /api/rpc.
HELIUS_MAINNET_RPC=

# Optional. Defaults to same-origin /api/upload-to-pinata (Vite dev middleware or Vercel).
VITE_PINATA_UPLOAD_API=

# Optional. Public CBS Collection Cap program ID for Devnet/test recognition.
# Leave empty until an explicit Devnet deploy is approved. Never put a secret key here.
# VITE_CBS_COLLECTION_CAP_PROGRAM_ID=

# Server-only. Required for artwork/metadata upload. Loaded by Vite into process.env on `npm run dev`.
# Never put this value in VITE_* or client source.
PINATA_JWT=
